# Exemplo de arquivo de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus valores

# Configurações do GitHub (para atualização automática)
GITHUB_TOKEN=seu_token_aqui
GITHUB_OWNER=seu_usuario_ou_org
GITHUB_REPO=seu_repositorio

# Configurações de proxy (opcional)
# PROXY_HOST=
# PROXY_PORT=
# PROXY_USER=
# PROXY_PASS=

# Outras configurações
# LOG_LEVEL=debug