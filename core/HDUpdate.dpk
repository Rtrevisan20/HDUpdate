package HDUpdate;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  dbrtl,
  fmx,
  IndySystem;

contains
  HDUpdate.View.Update in 'src\view\HDUpdate.View.Update.pas' {ViewUpdate},
  HDUpdate.View.Utils in 'src\view\HDUpdate.View.Utils.pas',
  HDUpdate.View.Update.Thread in 'src\view\HDUpdate.View.Update.Thread.pas',
  HDUpdate.Core.Update.Thread in 'src\core\HDUpdate.Core.Update.Thread.pas',
  HDUpdate.Core.Interfaces in 'src\core\HDUpdate.Core.Interfaces.pas',
  HDUpdate.Core.Types in 'src\core\HDUpdate.Core.Types.pas',
  HDUpdate.Language.Interfaces in 'src\language\HDUpdate.Language.Interfaces.pas',
  HDUpdate.Language.US in 'src\language\HDUpdate.Language.US.pas',
  HDUpdate.Language.PTbr in 'src\language\HDUpdate.Language.PTbr.pas',
  HDUpdate.Language.Consts.Factory in 'src\language\HDUpdate.Language.Consts.Factory.pas',
  HDUpdate.Internet.Interfaces in 'src\internet\HDUpdate.Internet.Interfaces.pas',
  HDUpdate.Internet.HttpClientHook in 'src\internet\HDUpdate.Internet.HttpClientHook.pas',
  HDUpdate.Internet in 'src\internet\HDUpdate.Internet.pas',
  HDUpdate.Internet.Factory in 'src\internet\HDUpdate.Internet.Factory.pas',
  HDUpdate.Core.Commons in 'src\core\HDUpdate.Core.Commons.pas',
  HDUpdate.Core.Updater in 'src\core\HDUpdate.Core.Updater.pas',
  HDUpdate.Core.Utils in 'src\core\HDUpdate.Core.Utils.pas',
  HDUpdate.Core.Check in 'src\core\HDUpdate.Core.Check.pas',
  HDUpdate in 'src\HDUpdate.pas',
  HDMessageDlg.Interfaces in 'modules\hdmessagedlg\src\HDMessageDlg.Interfaces.pas',
  HDMessageDlg.Consts in 'modules\hdmessagedlg\src\HDMessageDlg.Consts.pas',
  HDMessageDlg.IconsSVG in 'modules\hdmessagedlg\src\HDMessageDlg.IconsSVG.pas',
  HDMessageDlg in 'modules\hdmessagedlg\src\HDMessageDlg.pas',
  HDMessageDlg.View.FMX in 'modules\hdmessagedlg\src\FMX\HDMessageDlg.View.FMX.pas' {HDMessageDlgFMX};

end.
